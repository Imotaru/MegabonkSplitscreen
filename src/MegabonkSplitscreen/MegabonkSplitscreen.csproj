<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP runs plugins on .NET 6 -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MegabonkSplitscreen</AssemblyName>
    <RootNamespace>MegabonkSplitscreen</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <!-- Don't fetch the unused ASP.NET / Windows Desktop reference packs during restore -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <GameDir Condition="'$(GameDir)' == ''">H:\SteamLibrary\steamapps\common\Megabonk</GameDir>
  </PropertyGroup>

  <!-- Compile against the game's BepInEx and generated interop DLLs; none are copied to the output -->
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll" Private="false" />    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Rewired_Core.dll" Private="false" />
  </ItemGroup>

</Project>
